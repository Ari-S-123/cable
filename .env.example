# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Runtime mode. Deterministic mode never calls external vendors.
INTEGRATION_MODE=deterministic
DEMO_MODE=true
EXTERNAL_ACTIONS_ENABLED=false
HINDI_CONSENT_TEMPLATE_APPROVED=false
TWILIO_ENABLED=false

# WorkOS and Convex
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_WEBHOOK_SECRET=
CONVEX_DEPLOY_KEY=

# Inference and voice
FIREWORKS_API_KEY=
FIREWORKS_MODEL_ID=accounts/fireworks/models/glm-5p2
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Delivery. Twilio values may remain empty when TWILIO_ENABLED=false.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_ADDRESS=
APPROVED_PROVIDER_EMAILS=
APPROVED_PROVIDER_PHONES=

# Policy validation and observability
DAYTONA_API_KEY=
DAYTONA_API_URL=
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_NAME=CABLE-local
AUDIT_HASH_SECRET=
