{
  "name": "cable",
  "version": "0.1.0",
  "private": true,
  "description": "Consent-first multilingual voice care coordination prototype.",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "policy-sandbox"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "eval": "bt eval evals --no-input --json",
    "eval:local": "bt eval evals --no-send-logs --no-input --json",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "seed": "node --import tsx scripts/seed-demo.ts",
    "verify:env": "node --import tsx scripts/verify-env.ts",
    "check": "node --import tsx scripts/run-checks.ts"
  },
  "dependencies": {
    "@convex-dev/workos": "0.0.3",
    "@copilotkit/react-core": "1.63.2",
    "@copilotkit/react-ui": "1.63.2",
    "@copilotkit/runtime": "1.63.2",
    "@daytona/sdk": "0.200.1",
    "@elevenlabs/elevenlabs-js": "2.59.0",
    "@elevenlabs/react": "1.10.2",
    "@hookform/resolvers": "5.4.0",
    "@ai-sdk/openai": "3.0.88",
    "@workos-inc/authkit-nextjs": "4.3.0",
    "@workos-inc/node": "10.8.0",
    "ai": "6.0.235",
    "autoevals": "0.3.0",
    "braintrust": "3.24.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.42.3",
    "date-fns": "4.4.0",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "next-intl": "4.13.4",
    "next-themes": "0.4.6",
    "openai": "6.49.0",
    "radix-ui": "1.6.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.82.0",
    "resend": "6.18.0",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "twilio": "6.0.2",
    "vaul": "1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.11",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "convex-test": "0.0.54",
    "eslint": "10.7.0",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-jsdoc": "63.2.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "shadcn": "4.14.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
